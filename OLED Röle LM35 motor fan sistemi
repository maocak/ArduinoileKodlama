#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// Pin Tanımlamaları
const byte lm35Pin = A0;
const byte relayPin = 7;
const byte buzzerPin = 8;
const byte btnUpPin = 2;
const byte btnDownPin = 3;
const byte btnModePin = 4;

// Termostat ve Alarm Ayarları
float targetTemp = 25.0;
const float hysteresis = 0.5;
const float alarmThreshold = 45.0;
bool coolingMode = true;
bool relayState = false;
bool alarmActive = false;
bool buzzerBeepState = false;

// Röle tetikleme yönü (Ters çalışırsa false yap)
const bool relayActiveLow = true;

// Buton durum takibi
bool lastUpState = HIGH;
bool lastDownState = HIGH;
bool lastModeState = HIGH;

// Zamanlayıcılar
unsigned long lastUpdateTime = 0;
unsigned long lastAnimTime = 0;
unsigned long lastAlarmTime = 0;
bool animFrame = false;
float currentTemp = 25.0;

// --- 16x16 İKONLAR ---
