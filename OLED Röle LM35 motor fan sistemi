void setup() {
  pinMode(relayPin, OUTPUT);
  pinMode(buzzerPin, OUTPUT);
  pinMode(btnUpPin, INPUT_PULLUP);
  pinMode(btnDownPin, INPUT_PULLUP);
  pinMode(btnModePin, INPUT_PULLUP);

  setRelay(false);
  digitalWrite(buzzerPin, LOW);

  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  
  currentTemp = readTemperature();
  updateThermostatLogic();
  drawThermostatUI(currentTemp);
}

void loop() {
  bool needsRedraw = handleButtons();

  if (millis() - lastUpdateTime >= 250) {
    lastUpdateTime = millis();
    currentTemp = readTemperature();
    updateThermostatLogic();
    needsRedraw = true;
  }

  // 3. Alarm aktifse osilatörü kapatmadan iki ton arası geçiş yap (Pat-pat sesini önler)
  if (alarmActive) {
    if (millis() - lastAlarmTime >= 350) {
      lastAlarmTime = millis();
      buzzerBeepState = !buzzerBeepState;
      if (buzzerBeepState) {
        tone(buzzerPin, 1000); // 1. Ton: 1000 Hz
      } else {
        tone(buzzerPin, 750);  // 2. Ton: 750 Hz (noTone yerine ton değiştiriyoruz)
      }
      needsRedraw = true;
    }
  } else if (buzzerBeepState) {
    buzzerBeepState = false;
    noTone(buzzerPin);
    needsRedraw = true;
  }

  if (!alarmActive && relayState && (millis() - lastAnimTime >= 120)) {
    lastAnimTime = millis();
    animFrame = !animFrame;
    needsRedraw = true;
  }

  if (needsRedraw) {
    drawThermostatUI(currentTemp);
  }
}

bool handleButtons() {
  bool changed = false;

  bool upState = digitalRead(btnUpPin);
  bool downState = digitalRead(btnDownPin);
  bool modeState = digitalRead(btnModePin);

  if (lastUpState == HIGH && upState == LOW) {
    targetTemp += 0.5;
    if (targetTemp > 100.0) targetTemp = 100.0;
    changed = true;
  }

  if (lastDownState == HIGH && downState == LOW) {
    targetTemp -= 0.5;
    if (targetTemp < 2.0) targetTemp = 2.0;
    changed = true;
  }

  if (lastModeState == HIGH && modeState == LOW) {
    coolingMode = !coolingMode;
    relayState = false;
    changed = true;
  }

  lastUpState = upState;
  lastDownState = downState;
  lastModeState = modeState;

  if (changed) updateThermostatLogic();
  return changed;
}

void updateThermostatLogic() {
  if (currentTemp >= alarmThreshold) {
    alarmActive = true;
  } else if (currentTemp <= alarmThreshold - 0.5) {
    alarmActive = false;
  }

  if (coolingMode) {
    if (currentTemp >= targetTemp + hysteresis) {
      relayState = true;
    } else if (currentTemp <= targetTemp - hysteresis) {
      relayState = false;
    }
  } else {
    if (alarmActive) {
      relayState = false;
    } else if (currentTemp <= targetTemp - hysteresis) {
      relayState = true;
    } else if (currentTemp >= targetTemp + hysteresis) {
      relayState = false;
    }
  }
  setRelay(relayState);
}

float readTemperature() {
  uint16_t totalADC = 0;
  for (byte i = 0; i < 8; i++) {
    totalADC += analogRead(lm35Pin);
  }
  return ((totalADC / 8.0) * 500.0) / 1024.0;
}

void setRelay(bool state) {
  if (relayActiveLow) {
    digitalWrite(relayPin, state ? LOW : HIGH);
  } else {
    digitalWrite(relayPin, state ? HIGH : LOW);
  }
}

void drawThermostatUI(float temp) {
  display.clearDisplay();

  // Üst Bar
  display.setTextSize(1);
  if (coolingMode) {
    display.fillRect(0, 0, 52, 11, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
    display.setCursor(4, 2);
    display.print(F("SOGUTMA"));
    display.setTextColor(SSD1306_WHITE);
  } else {
    display.drawRect(0, 0, 52, 11, SSD1306_WHITE);
    display.setCursor(7, 2);
    display.print(F("ISITMA"));
  }

  display.setCursor(62, 2);
  display.print(F("Hdf:"));
  display.print(targetTemp, 1);
  display.print((char)247);

  // Orta Alan
  display.setTextSize(3);
  display.setCursor(4, 17);
  display.print(temp, 1);
  display.setTextSize(2);
  display.print((char)247);
  display.print(F("C"));

  // Alt Alan
  display.drawLine(0, 44, 128, 44, SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 51);

  if (alarmActive) {
    display.print(F("! YUKSEK SICAKLIK !"));
    if (buzzerBeepState) {
      display.drawBitmap(110, 47, warning_icon, 16, 16, SSD1306_WHITE);
    }
  } 
  else if (coolingMode) {
    display.print(F("FAN: "));
    display.print(relayState ? F("CALISIYOR") : F("BEKLEMEDE"));
    display.drawBitmap(108, 47, (relayState && animFrame) ? fan_frame2 : fan_frame1, 16, 16, SSD1306_WHITE);
  } 
  else {
    display.print(F("ISITICI: "));
    display.print(relayState ? F("AKTIF") : F("KAPALI"));
    if (relayState) {
      display.drawBitmap(108, 47, animFrame ? flame_frame2 : flame_frame1, 16, 16, SSD1306_WHITE);
    } else {
      display.drawBitmap(108, 47, flame_idle, 16, 16, SSD1306_WHITE);
    }
  }

  display.display();
}
