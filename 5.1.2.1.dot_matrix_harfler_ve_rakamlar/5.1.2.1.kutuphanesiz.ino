// --- PIN TANIMLARI ---
const int DIN_PIN = 12; // MAX7219 DIN
const int CS_PIN  = 11; // MAX7219 CS (LOAD)
const int CLK_PIN = 10; // MAX7219 CLK

// --- MAX7219 REGISTER ADRESLERİ ---
#define REG_DECODE_MODE  0x09
#define REG_INTENSITY    0x0A
#define REG_SCAN_LIMIT   0x0B
#define REG_SHUTDOWN     0x0C
#define REG_DISPLAY_TEST 0x0F

// --- FONT TABLOSU (5 Sütun x 8 Satır) ---
// A'dan Z'ye (26 Harf) + 0'dan 9'a (10 Rakam) = Toplam 36 Karakter
const byte FONT[][5] = {
  // A - Z
  {0x7E, 0x11, 0x11, 0x11, 0x7E}, // A (0)
  {0x7F, 0x49, 0x49, 0x49, 0x36}, // B (1)
  {0x3E, 0x41, 0x41, 0x41, 0x22}, // C (2)
  {0x7F, 0x41, 0x41, 0x22, 0x1C}, // D (3)
  {0x7F, 0x49, 0x49, 0x49, 0x41}, // E (4)
  {0x7F, 0x09, 0x09, 0x09, 0x01}, // F (5)
  {0x3E, 0x41, 0x49, 0x49, 0x7A}, // G (6)
  {0x7F, 0x08, 0x08, 0x08, 0x7F}, // H (7)
  {0x00, 0x41, 0x7F, 0x41, 0x00}, // I (8)
  {0x20, 0x40, 0x41, 0x3F, 0x01}, // J (9)
  {0x7F, 0x08, 0x14, 0x22, 0x41}, // K (10)
  {0x7F, 0x40, 0x40, 0x40, 0x40}, // L (11)
  {0x7F, 0x02, 0x0C, 0x02, 0x7F}, // M (12)
  {0x7F, 0x04, 0x08, 0x10, 0x7F}, // N (13)
  {0x3E, 0x41, 0x41, 0x41, 0x3E}, // O (14)
  {0x7F, 0x09, 0x09, 0x09, 0x06}, // P (15)
  {0x3E, 0x41, 0x51, 0x21, 0x5E}, // Q (16)
  {0x7F, 0x09, 0x19, 0x29, 0x46}, // R (17)
  {0x46, 0x49, 0x49, 0x49, 0x31}, // S (18)
  {0x01, 0x01, 0x7F, 0x01, 0x01}, // T (19)
  {0x3F, 0x40, 0x40, 0x40, 0x3F}, // U (20)
  {0x1F, 0x20, 0x40, 0x20, 0x1F}, // V (21)
  {0x7F, 0x20, 0x18, 0x20, 0x7F}, // W (22)
  {0x63, 0x14, 0x08, 0x14, 0x63}, // X (23)
  {0x07, 0x08, 0x70, 0x08, 0x07}, // Y (24)
  {0x61, 0x51, 0x49, 0x45, 0x43}, // Z (25)

  // 0 - 9
  {0x3E, 0x51, 0x49, 0x45, 0x3E}, // 0 (26)
  {0x00, 0x42, 0x7F, 0x40, 0x00}, // 1 (27)
  {0x42, 0x61, 0x51, 0x49, 0x46}, // 2 (28)
  {0x21, 0x41, 0x45, 0x4B, 0x31}, // 3 (29)
  {0x18, 0x14, 0x12, 0x7F, 0x10}, // 4 (30)
  {0x27, 0x45, 0x45, 0x45, 0x39}, // 5 (31)
  {0x3C, 0x4A, 0x49, 0x49, 0x30}, // 6 (32)
  {0x01, 0x71, 0x09, 0x05, 0x03}, // 7 (33)
  {0x36, 0x49, 0x49, 0x49, 0x36}, // 8 (34)
  {0x06, 0x49, 0x49, 0x29, 0x1E}  // 9 (35)
};

const int TOPLAM_KARAKTER = sizeof(FONT) / sizeof(FONT[0]);

// MAX7219'a veri gönderen temel SPI fonksiyonu
void sendData(byte reg, byte data) {
  digitalWrite(CS_PIN, LOW);
  shiftOut(DIN_PIN, CLK_PIN, MSBFIRST, reg);
  shiftOut(DIN_PIN, CLK_PIN, MSBFIRST, data);
  digitalWrite(CS_PIN, HIGH);
}

// Tüm ekranı temizler
void clearDisplay() {
  for (byte i = 1; i <= 8; i++) {
    sendData(i, 0x00);
  }
}

// 5 sütunluk karakteri 8x8 matrisin ortasına (2-6. sütunlar arasına) çizer
void drawCharacter(const byte sprite[5]) {
  clearDisplay();
  for (byte col = 0; col < 5; col++) {
    sendData(col + 2, sprite[col]);
  }
}

void setup() {
  pinMode(DIN_PIN, OUTPUT);
  pinMode(CS_PIN, OUTPUT);
  pinMode(CLK_PIN, OUTPUT);

  // MAX7219 Başlatma Ayarları
  sendData(REG_DISPLAY_TEST, 0x00); // Test modunu kapat
  sendData(REG_DECODE_MODE, 0x00);  // Ham matris modu (kod çözücü kapalı)
  sendData(REG_SCAN_LIMIT, 0x07);   // 8 sütunun tamamını tara (0-7)
  sendData(REG_INTENSITY, 0x08);    // Parlaklık (0-15 arası)
  sendData(REG_SHUTDOWN, 0x01);     // Normal çalışma moduna al

  clearDisplay();
}

void loop() {
  // Tüm harfleri (A-Z) ve rakamları (0-9) sırayla ekrana basar
  for (int i = 0; i < TOPLAM_KARAKTER; i++) {
    drawCharacter(FONT[i]);
    delay(1000); // 1 saniye bekle
  }
}
